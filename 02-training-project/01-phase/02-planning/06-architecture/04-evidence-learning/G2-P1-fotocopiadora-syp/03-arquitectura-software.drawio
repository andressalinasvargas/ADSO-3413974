<mxfile host="app.diagrams.net" type="device"><diagram id="syp-diagram" name="G2-P1 (A4) · Arquitectura Hexagonal (Puertos y Adaptadores) — Fotocopiadora SyP"><mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="440"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="G2-P1 (A4) · Arquitectura Hexagonal (Puertos y Adaptadores) — Fotocopiadora SyP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1410" height="28" as="geometry" /></mxCell><mxCell id="AdpPWA" value="&lt;b&gt;Adaptador Primario · PWA Web&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;index, productos, cotizacion&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;servicio-tecnico, sw.js offline&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="240" height="120" as="geometry" /></mxCell><mxCell id="AdpAdmin" value="&lt;b&gt;Adaptador Primario · Admin SPA&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;admin.html, login.html&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Panel KPI, CRUD y Export CSV&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="235" width="240" height="110" as="geometry" /></mxCell><mxCell id="PortIn" value="&lt;b&gt;Puertos de Entrada (API REST)&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;FastAPI Routers (HTTP/JSON)&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Validacion Pydantic + JWT HttpOnly&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Anti-doble envio y RBAC&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="230" height="160" as="geometry" /></mxCell><mxCell id="CoreDom" value="&lt;b&gt;Nucleo Dominio &amp;amp; Aplicacion&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Entidades (Persona, Pedido, Cotiz.)&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Comandos GoF + Fabrica Abstracta&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Calculador IVA 19% / Totales COP&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Enmascaramiento is_owner&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="270" height="220" as="geometry" /></mxCell><mxCell id="PortOut" value="&lt;b&gt;Puertos de Salida (Interfaces)&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;IRepositorioComercial&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;IExportadorCsvSeguro&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;ICanalMensajeria&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="950" y="140" width="220" height="160" as="geometry" /></mxCell><mxCell id="AdpDB" value="&lt;b&gt;Adaptador SQLAlchemy&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;PostgreSQL 16 / SQLite 3&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;12 tablas 3FN normalizadas&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#065F46;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1220" y="75" width="200" height="105" as="geometry" /></mxCell><mxCell id="AdpCSV" value="&lt;b&gt;Adaptador CSV &amp;amp; Impresion&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Sanitizador anti-formula CSV&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Vista imprimible cotizacion&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#065F46;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="200" height="95" as="geometry" /></mxCell><mxCell id="AdpWA" value="&lt;b&gt;Adaptador Mensajeria / Fallback&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Canal WhatsApp oficial SyP&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Respaldo estatico localStorage&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#065F46;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1220" y="315" width="200" height="95" as="geometry" /></mxCell><mxCell id="e_1" value="HTTPS JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=classic;" edge="1" parent="1" source="AdpPWA" target="PortIn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_2" value="HTTPS Cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=classic;" edge="1" parent="1" source="AdpAdmin" target="PortIn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3" value="IComandoOperacion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=classic;" edge="1" parent="1" source="PortIn" target="CoreDom"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4" value="invoca puerto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=classic;" edge="1" parent="1" source="CoreDom" target="PortOut"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_5" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=block;endFill=0;endSize=10;" edge="1" parent="1" source="AdpDB" target="PortOut"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_6" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=block;endFill=0;endSize=10;" edge="1" parent="1" source="AdpCSV" target="PortOut"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_7" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=block;endFill=0;endSize=10;" edge="1" parent="1" source="AdpWA" target="PortOut"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
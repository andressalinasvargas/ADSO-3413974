        <mxCell id="t" value="A6 · Vista de Despliegue (4 Nodos, Artefactos, Protocolos y Decisiones RNF) — asistencia-sena" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="950" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;«device» Nodo 1: Cliente Escritorio&lt;/b&gt;&lt;hr&gt;Navegador Chrome / Edge&lt;br&gt;• WebAppInstructor&lt;br&gt;• API BarcodeDetector (Escáner QR)&lt;br&gt;• Caché CSS / JS&lt;hr&gt;&lt;i&gt;RNF-01: canal TLS para cámara y cookies&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="320" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;«device» Nodo 2: Cliente Móvil Aprendiz&lt;/b&gt;&lt;hr&gt;Navegador Android / iOS (≥ 390 px)&lt;br&gt;• WebAppMovilAprendiz (codigo/registro)&lt;br&gt;• Geolocation API HTML5&lt;br&gt;• Consentimiento Ley 1581&lt;hr&gt;&lt;i&gt;RNF-02, RNF-04: registro en ≤ 3 pasos&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="320" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;«executionEnvironment» Nodo 3: Servidor Aplicación&lt;/b&gt;&lt;hr&gt;Contenedor Docker: sena-asistencias-web&lt;br&gt;• Apache 2.4 + PHP 8.3 (TZ -05:00)&lt;br&gt;• FachadaControlAsistencia + Estrategias + PDO&lt;br&gt;• Reglas .htaccess (403 en /docs, /e2e, config.php)&lt;br&gt;• Cabeceras X-Frame-Options, nosniff&lt;hr&gt;&lt;i&gt;RNF-01, RNF-03, RNF-05: Healthcheck HTTP&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="520" y="195" width="400" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;«database» Nodo 4: Servidor de Datos&lt;/b&gt;&lt;hr&gt;Contenedor Docker: sena-asistencias-db&lt;br&gt;• MariaDB 10.11 InnoDB (utf8mb4)&lt;br&gt;• BD sena_asistencias (10 tablas 3FN)&lt;br&gt;• Volumen persistente sena_db_data&lt;br&gt;• Respaldo automático mysqldump&lt;hr&gt;&lt;i&gt;RNF-01, RNF-06: sin exposición a Internet&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#ede9fe;strokeColor=#9673a6;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1060" y="195" width="350" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="HTTPS · TCP 443 (TLS 1.3)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="n1" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2" value="HTTPS · TCP 443 (TLS 1.3)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3" value="PDO · TCP 3306 (Red privada Docker)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>

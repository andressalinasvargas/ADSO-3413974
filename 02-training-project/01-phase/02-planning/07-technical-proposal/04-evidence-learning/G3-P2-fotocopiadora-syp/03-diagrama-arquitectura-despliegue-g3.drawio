<mxfile host="app.diagrams.net" type="device"><diagram id="syp-diagram" name="G3-P2 (B3) · Arquitectura de Despliegue Productiva (7 Nodos Trazables a B2)"><mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1310" pageHeight="410"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="G3-P2 (B3) · Arquitectura de Despliegue Productiva (7 Nodos Trazables a B2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1270" height="28" as="geometry" /></mxCell><mxCell id="N1" value="&lt;b&gt;[N1] Navegador Cliente PWA (EXCLUIDO)&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Equipos/moviles propios del comprador&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;PWA + sw.js + fallback localStorage&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Presupuesto B2: $0 (Excluido)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;dashed=1;" vertex="1" parent="1"><mxGeometry x="25" y="70" width="250" height="115" as="geometry" /></mxCell><mxCell id="N2" value="&lt;b&gt;[N2] Estacion Administrador (EXCLUIDO)&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;PC actual del personal de SyP en Neiva&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;admin.html, exportacion CSV y reportes&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Presupuesto B2: $0 (Hardware cliente)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;dashed=1;" vertex="1" parent="1"><mxGeometry x="25" y="225" width="250" height="115" as="geometry" /></mxCell><mxCell id="N3" value="&lt;b&gt;[N3] Borde DNS + Proxy TLS 1.3&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Dominio .com/.co + CDN HTTPS 443&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Certificado Let&amp;#x27;s Encrypt + CSP/HSTS&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Presupuesto B2: Dominio + Proxy&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#6B21A8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="345" y="145" width="260" height="130" as="geometry" /></mxCell><mxCell id="N4" value="&lt;b&gt;[N4] Servidor Aplicacion API (Docker)&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;VPS Linux (N_srv nodos segun variante)&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;FastAPI + Uvicorn + 9 Routers + BCrypt&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Presupuesto B2: VPS + Desarrollo/QA&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1E40AF;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="675" y="70" width="265" height="130" as="geometry" /></mxCell><mxCell id="N5" value="&lt;b&gt;[N5] Servidor Base de Datos (Privado)&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;PostgreSQL 16 (red Docker privada)&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;12 tablas 3FN + cifrado en reposo&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Presupuesto B2: Aislado en VPS / DBaaS&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="675" y="240" width="265" height="130" as="geometry" /></mxCell><mxCell id="N6" value="&lt;b&gt;[N6] Respaldos Externos S3 Cifrados&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Almacenamiento S3 externo (AES-256)&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Volcado diario 02:00 COT · retencion 30d&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Presupuesto B2: Bucket S3 (RPO &amp;lt;= 24h)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1010" y="70" width="265" height="130" as="geometry" /></mxCell><mxCell id="N7" value="&lt;b&gt;[N7] Monitoreo Externo y Alertas ANS&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Sondeo HTTPS cada 60s (ANS-01/02)&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Alertas tempranas P1 &amp;lt;= 30 min&lt;/div&gt;&lt;div style='font-size:11px;line-height:1.3'&gt;Presupuesto B2: Servicio Monitoreo 24/7&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#BE123C;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1010" y="240" width="265" height="130" as="geometry" /></mxCell><mxCell id="e_1" value="HTTPS 443 TLS 1.3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=classic;" edge="1" parent="1" source="N1" target="N3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_2" value="HTTPS 443 TLS 1.3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=classic;" edge="1" parent="1" source="N2" target="N3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3" value="Proxy REST JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=classic;" edge="1" parent="1" source="N3" target="N4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4" value="TCP 5432 Privado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=classic;" edge="1" parent="1" source="N4" target="N5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_5" value="Backup S3 HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;endArrow=classic;" edge="1" parent="1" source="N5" target="N6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_6" value="Sondeo 60s ANS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;fontSize=10;dashed=1;endArrow=open;" edge="1" parent="1" source="N7" target="N3"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
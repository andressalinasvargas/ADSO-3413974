<mxfile host="app.diagrams.net" modified="2026-11-23T19:45:00.000Z" agent="ADSO-3413974" version="24.7.17">
  <diagram id="g3-deploy-arch" name="Arquitectura y Despliegue Propuesta Tecnica G3">
    <mxGraphModel dx="1600" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="B3 · Arquitectura de Despliegue en Producción (7 Nodos Trazables al Presupuesto B2) — asistencia-sena" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1150" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;[N1] Cliente Escritorio (Instructor / Coordinador)&lt;/b&gt;&lt;hr&gt;Navegador Chrome / Edge&lt;br&gt;• WebAppInstructor + BarcodeDetector&lt;br&gt;• Sin instalación local&lt;hr&gt;&lt;i&gt;B2: Excluido (equipo existente del cliente)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="95" width="290" height="175" as="geometry"/>
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;[N2] Cliente Móvil (Aprendiz — BYOD)&lt;/b&gt;&lt;hr&gt;Navegador Android / iOS (≥ 390 px)&lt;br&gt;• WebAppMovilAprendiz + Geolocation API&lt;br&gt;• Consentimiento Ley 1581 / Código 6 dígitos&lt;hr&gt;&lt;i&gt;B2: Excluido (dispositivo propio + contingencia)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="290" height="175" as="geometry"/>
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;[N3] Borde DNS, Dominio y Proxy TLS&lt;/b&gt;&lt;hr&gt;• Dominio institucional (.co/.com)&lt;br&gt;• Proxy Inverso (Nginx / Caddy)&lt;br&gt;• Certificado Let's Encrypt (TLS 1.3)&lt;br&gt;• Cabeceras HSTS, X-Frame, nosniff&lt;hr&gt;&lt;i&gt;B2: Rubro Dominio/DNS y Seguridad&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="205" width="275" height="205" as="geometry"/>
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;[N4] Servidor de Aplicación (VPS / Nube)&lt;/b&gt;&lt;hr&gt;Ubuntu 24.04 LTS + Docker Engine CE&lt;br&gt;Contenedor: sena-asistencias-web&lt;br&gt;• Apache 2.4 + PHP 8.3 (TZ -05:00)&lt;br&gt;• Fachada + Estrategias + PDO + qrcodejs local&lt;br&gt;• Blindaje .htaccess (HTTP 403 internos)&lt;hr&gt;&lt;i&gt;B2: Rubro Nube/VPS + Desarrollo Software&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="815" y="185" width="330" height="245" as="geometry"/>
        </mxCell>

        <mxCell id="n5" value="&lt;b&gt;[N5] Servidor de Datos (Red Privada)&lt;/b&gt;&lt;hr&gt;Contenedor: sena-asistencias-db&lt;br&gt;• MariaDB 10.11 InnoDB (utf8mb4)&lt;br&gt;• Esquema 10 tablas 3FN + 22 CHECK&lt;br&gt;• Volumen SSD persistente sena_db_data&lt;br&gt;• Puerto 3306 cerrado a Internet&lt;hr&gt;&lt;i&gt;B2: Rubro Infraestructura Datos/Almacenamiento&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1245" y="185" width="320" height="245" as="geometry"/>
        </mxCell>

        <mxCell id="n6" value="&lt;b&gt;[N6] Almacenamiento Externo de Respaldos&lt;/b&gt;&lt;hr&gt;Object Storage S3-compatible (Encargado)&lt;br&gt;• mysqldump diario 02:00 a. m. cifrado AES-256&lt;br&gt;• Retención 30 días + prueba mensual&lt;hr&gt;&lt;i&gt;B2: Rubro Respaldos · ANS: RPO ≤ 24 h / RTO ≤ 2 h&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1245" y="540" width="320" height="175" as="geometry"/>
        </mxCell>

        <mxCell id="n7" value="&lt;b&gt;[N7] Monitoreo Externo y Alertas ANS&lt;/b&gt;&lt;hr&gt;Servicio de sondeo HTTP externo&lt;br&gt;• Healthcheck HTTPS cada 60 s&lt;br&gt;• Medición disponibilidad y latencia p95&lt;hr&gt;&lt;i&gt;B2: Rubro Operación y Soporte · ANS B6&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="540" width="290" height="175" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="HTTPS · TCP 443 (TLS 1.3)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="n1" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="HTTPS · TCP 443 (TLS 1.3)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="HTTP interno · TCP 8080/80" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="PDO · TCP 3306 (privado)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="HTTPS / S3 API (TLS 1.3 · 02:00)" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="HTTPS Healthcheck (60 s)" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="n7" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
